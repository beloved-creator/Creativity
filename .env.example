# 이 파일을 복사해 `.env.local` 로 이름을 바꾼 뒤 값을 채워 넣으세요.
# (.env.local 은 .gitignore 에 포함되어 GitHub에 올라가지 않습니다.)
# Netlify에서는 Site configuration → Environment variables 에 같은 이름으로 등록합니다.
# 값은 Firebase 콘솔 → 프로젝트 설정 → 내 앱 → firebaseConfig 에 있습니다.
# VITE_FIREBASE_* 를 비워 두면 Firebase 없이 src/data/ 내용으로 동작합니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=

# 개발용(선택): true 이면 로컬 Firebase 에뮬레이터(Firestore 8080, Auth 9099)에 연결
# VITE_USE_FIREBASE_EMULATOR=true
