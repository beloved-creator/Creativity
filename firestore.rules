// Firestore 보안 규칙
// ──────────────────────────────────────────────────────────────
// 적용 방법: Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에
//           이 파일 내용을 통째로 붙여 넣고 "게시(Publish)"를 누릅니다.
// ★ 붙여 넣기 전에 아래 ADMIN_EMAIL 자리의 이메일을
//   관리자 Google 계정(VITE_ADMIN_EMAIL 과 같은 값, 소문자)으로 바꾸세요.
// ──────────────────────────────────────────────────────────────
// - 읽기: 누구나 (공개 웹사이트)
// - 쓰기: 관리자 Google 계정으로 로그인했을 때만
// - 그 밖의 컬렉션: 읽기·쓰기 모두 금지
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'admin@example.com'; // ← ADMIN_EMAIL
    }

    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId == 'main';
    }

    match /publications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 공지 게시판: 누구나 읽기, 관리자만 쓰기
    match /posts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
